# ======================================================================
# HomelabSentinel — environment configuration (EXAMPLE)
# ----------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — no real secrets are ever committed.
# ======================================================================

# --- Anthropic (the agent's reasoning brain) ---
ANTHROPIC_API_KEY=
# Optional: override the agent model (claude-sonnet-4-6, claude-haiku-4-5, ...)
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-6

# --- Proxmox API (read guest state + gated restarts) ---
# Host: hostname/IP only — no scheme, no port. e.g. pve.lan or pve.lan
PROXMOX_HOST=
PROXMOX_PORT=8006
# From `pveum user token add ...` — looks like  agent@pve!sentinel
PROXMOX_TOKEN_ID=
# The UUID printed once when the token was created.
PROXMOX_TOKEN_SECRET=
# Default node name shown in the Proxmox web UI (usually "pve").
PROXMOX_DEFAULT_NODE=pve
# "true" to accept Proxmox's self-signed cert (common in homelabs);
# "false" once you've installed a real cert.
PROXMOX_VERIFY_TLS=false

# --- Home Assistant (read entities + gated service calls) ---
# Prefer the LAN address (no internet dependency). e.g. http://homeassistant.lan
HA_URL=
# Long-lived access token: HA profile -> Security -> Create Token.
HA_TOKEN=

# --- Telegram (chat front-end + Approve/Deny buttons) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to talk to the bot (this is the authz list).
TELEGRAM_CHAT_ID=

# --- Local LLM via llama.cpp (the cheap "helper" brain: summaries + RAG) ---
# OpenAI-compatible endpoint. MUST end in /v1.  e.g. http://llm.lan/v1
LLAMACPP_BASE_URL=
# The model NAME the server reports (llama-server --alias). Confirm with:
#   curl http://<host>/v1/models
LLAMACPP_MODEL=active
# Matches the --api-key the server was started with (e.g. openssl rand -hex 16).
LLAMACPP_API_KEY=

# --- LangSmith tracing (optional — see agent_v4_langsmith.py) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=homelab-sentinel

# --- Alexa voice bridge (voice_server.py) ---
# Shared bearer token HA sends with each /voice request (long random string).
VOICE_SERVER_TOKEN=
# notify.<this> is your Echo target in HA, e.g. alexa_media_<your_echo>
VOICE_ALEXA_TARGET=
VOICE_SERVER_PORT=8099

# --- Docker via Portainer (container health + gated restarts) ---
# e.g. https://portainer.lan
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=2
PORTAINER_VERIFY_TLS=false

# --- Internet speed monitor (speedtest_monitor.py) ---
# Pure-httpx throughput test against Cloudflare's speed endpoints (no extra deps).
# All optional — sane defaults are baked in. Floors (throughput) and the latency
# ceiling below drive the warning/critical classification + Telegram alerts;
# tune them to your plan.
SPEEDTEST_DOWNLOAD_WARN_MBPS=100
SPEEDTEST_DOWNLOAD_CRIT_MBPS=50
SPEEDTEST_UPLOAD_WARN_MBPS=20
SPEEDTEST_UPLOAD_CRIT_MBPS=10
SPEEDTEST_LATENCY_WARN_MS=60
SPEEDTEST_LATENCY_CRIT_MS=150
# Payload sizes (bytes) + per-request timeout. Bump sizes down on a slow link.
SPEEDTEST_DOWNLOAD_BYTES=10000000
SPEEDTEST_UPLOAD_BYTES=5000000
SPEEDTEST_TIMEOUT_S=30
# Override only if you self-host a Cloudflare-compatible speed backend.
# SPEEDTEST_BASE_URL=https://speed.cloudflare.com

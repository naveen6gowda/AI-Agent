# ======================================================================
# HomelabSentinel — environment configuration (EXAMPLE)
# ----------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — no real secrets are ever committed.
# ======================================================================

# --- The LLM (single local model, OpenAI-compatible) ------------------
# One model powers everything: the agent loop, summaries, RAG, voice.
# Any OpenAI-compatible server works (LM Studio, llama.cpp, vLLM, ...).
# MUST end in /v1.  e.g. http://llm.lan:1234/v1
MLX_BASE_URL=
# The model id the server reports. Confirm with: curl $MLX_BASE_URL/models
# Pick a model that supports TOOL CALLING — the agent loop depends on it.
MLX_MODEL=
# Bearer token, if your server requires one (LM Studio: Settings → API token).
MLX_API_KEY=
# Generous timeouts: a cold model load or a busy box should not hard-fail.
MLX_AGENT_TIMEOUT=120
MLX_HELPER_TIMEOUT=90
MLX_MAX_RETRIES=2
# Reasoning models think before answering; floor the helper token budget so
# short summaries survive the thinking tokens. 0 = no floor.
MLX_HELPER_MIN_TOKENS=0

# --- Langfuse (self-hosted observability; optional but recommended) ---
# Leave the keys empty to disable tracing entirely.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Proxmox API (read guest state + gated restarts) ---
# Host: hostname/IP only — no scheme, no port. e.g. pve.lan
PROXMOX_HOST=
PROXMOX_PORT=8006
# From `pveum user token add ...` — looks like  agent@pve!sentinel
PROXMOX_TOKEN_ID=
# The UUID printed once when the token was created.
PROXMOX_TOKEN_SECRET=
# Default node name shown in the Proxmox web UI (usually "pve").
PROXMOX_DEFAULT_NODE=pve
# "true" to accept Proxmox's self-signed cert (common in homelabs);
# "false" once you've installed a real cert.
PROXMOX_VERIFY_TLS=false

# --- Home Assistant (read entities + gated service calls) ---
# Prefer the LAN address (no internet dependency). e.g. http://homeassistant.lan:8123
HA_URL=
# Long-lived access token: HA profile -> Security -> Create Token.
HA_TOKEN=

# --- Telegram (chat front-end + Approve/Deny buttons + failure pager) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to talk to the bot (this is the authz list).
TELEGRAM_CHAT_ID=

# --- Docker via Portainer (container health + gated restarts) ---
# e.g. https://docker.lan:9443
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=2
PORTAINER_VERIFY_TLS=false

# --- Alexa voice bridge (voice_server.py) ---
# Shared bearer token HA sends with each /voice request (long random string).
VOICE_SERVER_TOKEN=
# notify.<this> is your Echo target in HA, e.g. alexa_media_<your_echo>
VOICE_ALEXA_TARGET=
VOICE_SERVER_PORT=8099

# --- Finance bridge (finance_server.py → Firefly III) ---
# Shared bearer token HA sends with each /transaction request.
FINANCE_SERVER_TOKEN=
FINANCE_SERVER_PORT=8098
# Your Firefly III instance + a Personal Access Token (Profile → OAuth).
# e.g. http://firefly.lan:8080
FIREFLY_URL=
FIREFLY_TOKEN=
# The asset account new transactions are booked against, + default currency.
FINANCE_ASSET_ACCOUNT=Checking
FINANCE_DEFAULT_CURRENCY=EUR

# --- Commute monitor (db_train_monitor.py, MVG departures API) ---
# Find your stop's globalId via:
#   https://www.mvg.de/api/bgw-pt/v3/locations?query=<your stop name>
TRANSIT_STOP_ID=de:00000:0001
TRANSIT_STOP_NAME=YourVillage
# The S-Bahn/train line + destinations that mean "towards work".
TRANSIT_TRAIN_LINE=S2
TRANSIT_TRAIN_DESTINATIONS=City Central
# Optional feeder bus from your village to the station.
TRANSIT_BUS_LINE=700
TRANSIT_BUS_DESTINATIONS=LineTerminus
# Announce delays >= this many minutes; re-announce when the delay changes
# by at least the delta.
TRANSIT_MIN_DELAY_ANNOUNCE=5
TRANSIT_REANNOUNCE_DELTA=3
# Active window (the systemd timer should match).
TRANSIT_WINDOW_START=06:00
TRANSIT_WINDOW_END=09:00
TRANSIT_STATE_FILE=transit_state.json

# --- Internet speed monitor (speedtest_monitor.py) ---
# Alert when measured download drops below this floor (Mbps).
SPEEDTEST_MIN_DOWNLOAD_MBPS=20

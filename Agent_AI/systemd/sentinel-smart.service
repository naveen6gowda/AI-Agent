[Unit]
OnFailure=sentinel-failure-alert@%n.service
Description=HomelabSentinel SMART disk scan
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sentinel
EnvironmentFile=/opt/sentinel/.env
ExecStart=/root/.local/bin/uv run python smart_monitor.py --alert --no-summary
StandardOutput=journal
StandardError=journal

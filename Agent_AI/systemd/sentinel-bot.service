[Unit]
OnFailure=sentinel-failure-alert@%n.service
Description=HomelabSentinel — Telegram conversational bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/sentinel
ExecStart=/root/.local/bin/uv run python sentinel_bot.py
Restart=on-failure
RestartSec=10
# uv run exits 143 on SIGTERM and langfuse atexit turns SIGINT into 130:
# a normal stop/restart is not a failure (was firing false OnFailure pages).
SuccessExitStatus=130 143
KillSignal=SIGINT
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

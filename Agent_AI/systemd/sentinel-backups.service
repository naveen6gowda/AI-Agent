[Unit]
OnFailure=sentinel-failure-alert@%n.service
Description=HomelabSentinel backup verification
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sentinel
EnvironmentFile=/opt/sentinel/.env
ExecStart=/root/.local/bin/uv run python backup_verifier.py --alert --no-summary
StandardOutput=journal
StandardError=journal
# exit 2 = "found a problem, already sent its own alert" — not a unit failure
SuccessExitStatus=2
